{
  "name": "freewii",
  "private": true,
  "version": "0.1.0",
  "description": "An open-source Wii-like console that runs in the browser, with your phone as the Wii Remote.",
  "license": "MIT",
  "author": "freeWii contributors",
  "homepage": "https://github.com/Lucas-lux/freeWii#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lucas-lux/freeWii.git"
  },
  "bugs": {
    "url": "https://github.com/Lucas-lux/freeWii/issues"
  },
  "keywords": [
    "wii",
    "wii-menu",
    "browser-game",
    "webrtc",
    "peerjs",
    "gyroscope",
    "gamepad",
    "phone-controller",
    "react",
    "vite",
    "typescript",
    "minigames",
    "fan-project"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:https": "cross-env HTTPS=1 vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "peerjs": "^1.5.4",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
