# Normalize line endings: LF in the repository, native in the working copy.
* text=auto eol=lf

# Binary assets, never diffed or converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.mp3 binary
*.ogg binary
*.wav binary
*.m4a binary
*.webm binary
*.mp4 binary
*.woff binary
*.woff2 binary
*.ttf binary

# Keep generated noise out of pull request diffs and language stats.
package-lock.json -diff linguist-generated
docs/screenshots/* linguist-documentation
