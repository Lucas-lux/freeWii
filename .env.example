# Optional: self-hosted PeerJS signaling server (default = PeerJS public cloud)
# VITE_PEER_HOST=peer.example.com
# VITE_PEER_PORT=443
# VITE_PEER_PATH=/
# VITE_PEER_SECURE=1

# Optional: TURN relay, only needed when phone and PC are on different networks
# VITE_TURN_URL=turn:turn.example.com:3478
# VITE_TURN_USER=user
# VITE_TURN_PASS=secret
